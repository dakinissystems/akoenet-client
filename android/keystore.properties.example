# Copiar a keystore.properties (misma carpeta android/) — NO commitear.
# Necesario para subir .aab a Google Play (upload key).
#
# Si la app ya está en Play, usa el MISMO akoenet-release.jks (upload key registrada).
# alias suele ser: akoenet

storeFile=akoenet-release.jks
storePassword=TU_STORE_PASSWORD
keyAlias=akoenet
keyPassword=TU_KEY_PASSWORD
